# Global Caddyfile for ilha
# This file provides dynamic routing for worktree environments using Docker integration

{
    # auto_https left at Caddy default (on) — Caddy automatically provisions
    # TLS for real domains and ignores localhost/IP-only matchers.
    servers {
        protocols h1 h2
    }
    # Admin API bound to the container loopback ONLY. The API is unauthenticated,
    # so binding 0.0.0.0 exposed it to every container on the ilha_caddy_proxy
    # network — including untrusted worktree/app containers, which could then
    # rewrite the global proxy config (redirect/MITM every hosted domain).
    # The route monitor reaches it via 127.0.0.1 by sharing this container's
    # network namespace (network_mode: service:caddy in docker-compose).
    admin localhost:2019
}

# Default route for unknown domains
:80 {
    respond "ilha Global Caddy Proxy Ready - No worktree found for this domain" 200
    
    log {
        output stdout
        format console
    }
}

